import 'package:easy_localization/easy_localization.dart';
import 'package:flutter/material.dart';

import '../../../../core/theme/app_spacing.dart';
import '../../domain/entities/profile_settings.dart';
import '../controllers/profile_controller.dart';

/// Widget para la sección de configuraciones
class SettingsSection extends StatelessWidget {
  final ProfileSettings settings;
  final ProfileController controller;

  const SettingsSection({
    super.key,
    required this.settings,
    required this.controller,
  });

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          'Configuración',
          style: Theme.of(context).textTheme.titleLarge?.copyWith(
                fontWeight: FontWeight.bold,
              ),
        ),
        const SizedBox(height: AppSpacing.md),

        // Notificaciones
        _buildCard(
          context,
          title: 'Notificaciones',
          icon: Icons.notifications_outlined,
          children: [
            _buildSwitchTile(
              context,
              title: 'Notificaciones generales',
              subtitle: 'Activar o desactivar todas las notificaciones',
              value: settings.notificationsEnabled,
              onChanged: (value) => _updateSettings(
                context,
                settings.copyWith(notificationsEnabled: value),
              ),
            ),
            if (settings.notificationsEnabled) ...[
              const Divider(height: 1),
              _buildSwitchTile(
                context,
                title: 'Notificaciones push',
                subtitle: 'Recibir notificaciones push en el dispositivo',
                value: settings.pushNotifications,
                onChanged: (value) => _updateSettings(
                  context,
                  settings.copyWith(pushNotifications: value),
                ),
              ),
              const Divider(height: 1),
              _buildSwitchTile(
                context,
                title: 'Notificaciones por email',
                subtitle: 'Recibir resumen diario por email',
                value: settings.emailNotifications,
                onChanged: (value) => _updateSettings(
                  context,
                  settings.copyWith(emailNotifications: value),
                ),
              ),
              const Divider(height: 1),
              _buildSwitchTile(
                context,
                title: 'Comentarios',
                subtitle: 'Notificar cuando comenten tus chismes',
                value: settings.commentsNotifications,
                onChanged: (value) => _updateSettings(
                  context,
                  settings.copyWith(commentsNotifications: value),
                ),
              ),
              const Divider(height: 1),
              _buildSwitchTile(
                context,
                title: 'Nuevos seguidores',
                subtitle: 'Notificar cuando alguien te siga',
                value: settings.followNotifications,
                onChanged: (value) => _updateSettings(
                  context,
                  settings.copyWith(followNotifications: value),
                ),
              ),
            ],
          ],
        ),

        const SizedBox(height: AppSpacing.lg),

        // Privacidad
        _buildCard(
          context,
          title: 'Privacidad',
          icon: Icons.privacy_tip_outlined,
          children: [
            _buildListTile(
              context,
              title: 'Nivel de privacidad',
              subtitle: _getPrivacyLevelText(settings.privacyLevel),
              trailing: const Icon(Icons.chevron_right),
              onTap: () => _showPrivacyDialog(context),
            ),
            const Divider(height: 1),
            _buildSwitchTile(
              context,
              title: 'Mostrar email',
              subtitle: 'Permitir que otros usuarios vean tu email',
              value: settings.showEmail,
              onChanged: (value) => _updateSettings(
                context,
                settings.copyWith(showEmail: value),
              ),
            ),
            const Divider(height: 1),
            _buildSwitchTile(
              context,
              title: 'Mostrar actividad',
              subtitle: 'Mostrar tu última actividad en el perfil',
              value: settings.showActivity,
              onChanged: (value) => _updateSettings(
                context,
                settings.copyWith(showActivity: value),
              ),
            ),
          ],
        ),

        const SizedBox(height: AppSpacing.lg),

        // Idioma y apariencia
        _buildCard(
          context,
          title: 'Apariencia',
          icon: Icons.palette_outlined,
          children: [
            _buildListTile(
              context,
              title: 'Idioma',
              subtitle: settings.language == 'es' ? 'Español' : 'English',
              trailing: const Icon(Icons.chevron_right),
              onTap: () => _showLanguageDialog(context),
            ),
            const Divider(height: 1),
            _buildSwitchTile(
              context,
              title: 'Modo oscuro',
              subtitle: 'Usar tema oscuro en la aplicación',
              value: settings.darkMode,
              onChanged: (value) => _updateSettings(
                context,
                settings.copyWith(darkMode: value),
              ),
            ),
          ],
        ),
      ],
    );
  }

  Widget _buildCard(
    BuildContext context, {
    required String title,
    required IconData icon,
    required List<Widget> children,
  }) {
    return Card(
      elevation: 0,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(12),
        side: BorderSide(
          color: Theme.of(context).colorScheme.outline.withValues(alpha: 0.2),
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Padding(
            padding: const EdgeInsets.all(AppSpacing.lg),
            child: Row(
              children: [
                Icon(icon, color: Theme.of(context).colorScheme.primary),
                const SizedBox(width: AppSpacing.md),
                Text(
                  title,
                  style: Theme.of(context).textTheme.titleMedium?.copyWith(
                        fontWeight: FontWeight.bold,
                      ),
                ),
              ],
            ),
          ),
          ...children,
        ],
      ),
    );
  }

  Widget _buildSwitchTile(
    BuildContext context, {
    required String title,
    required String subtitle,
    required bool value,
    required ValueChanged<bool> onChanged,
  }) {
    return SwitchListTile(
      title: Text(title),
      subtitle: Text(subtitle),
      value: value,
      onChanged: onChanged,
      contentPadding: const EdgeInsets.symmetric(
        horizontal: AppSpacing.lg,
        vertical: AppSpacing.xs,
      ),
    );
  }

  Widget _buildListTile(
    BuildContext context, {
    required String title,
    required String subtitle,
    Widget? trailing,
    VoidCallback? onTap,
  }) {
    return ListTile(
      title: Text(title),
      subtitle: Text(subtitle),
      trailing: trailing,
      onTap: onTap,
      contentPadding: const EdgeInsets.symmetric(
        horizontal: AppSpacing.lg,
        vertical: AppSpacing.xs,
      ),
    );
  }

  String _getPrivacyLevelText(String level) {
    switch (level) {
      case 'public':
        return 'Público - Todos pueden ver tu perfil';
      case 'friends':
        return 'Amigos - Solo amigos pueden ver';
      case 'private':
        return 'Privado - Solo tú puedes ver';
      default:
        return 'Público';
    }
  }

  Future<void> _updateSettings(
    BuildContext context,
    ProfileSettings newSettings,
  ) async {
    final success = await controller.updateSetting(newSettings);
    if (!success && context.mounted) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Error al actualizar configuración'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  Future<void> _showPrivacyDialog(BuildContext context) async {
    final result = await showDialog<String>(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Nivel de privacidad'),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            _buildPrivacyOption(
              context,
              title: 'Público',
              subtitle: 'Todos pueden ver tu perfil',
              value: 'public',
              currentValue: settings.privacyLevel,
            ),
            _buildPrivacyOption(
              context,
              title: 'Amigos',
              subtitle: 'Solo tus amigos pueden ver',
              value: 'friends',
              currentValue: settings.privacyLevel,
            ),
            _buildPrivacyOption(
              context,
              title: 'Privado',
              subtitle: 'Solo tú puedes ver',
              value: 'private',
              currentValue: settings.privacyLevel,
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Cancelar'),
          ),
        ],
      ),
    );

    if (result != null && context.mounted) {
      await _updateSettings(
        context,
        settings.copyWith(privacyLevel: result),
      );
    }
  }

  Widget _buildPrivacyOption(
    BuildContext context, {
    required String title,
    required String subtitle,
    required String value,
    required String currentValue,
  }) {
    return RadioGroup<String>(
      groupValue: currentValue,
      onChanged: (newValue) {
        if (newValue != null) {
          Navigator.pop(context, newValue);
        }
      },
      child: RadioListTile<String>(
        title: Text(title),
        subtitle: Text(subtitle),
        value: value,
      ),
    );
  }

  Future<void> _showLanguageDialog(BuildContext context) async {
    final result = await showDialog<String>(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Idioma'),
        content: RadioGroup<String>(
          groupValue: settings.language,
          onChanged: (value) {
            if (value != null) {
              Navigator.pop(context, value);
            }
          },
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              RadioListTile<String>(
                title: const Text('Español'),
                value: 'es',
              ),
              RadioListTile<String>(
                title: const Text('English'),
                value: 'en',
              ),
            ],
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Cancelar'),
          ),
        ],
      ),
    );

    if (result != null && context.mounted) {
      await _updateSettings(
        context,
        settings.copyWith(language: result),
      );
    }
  }
}
