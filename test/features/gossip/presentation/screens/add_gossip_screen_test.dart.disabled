import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:mockito/mockito.dart';
import 'package:chismes/features/gossip/presentation/screens/add_gossip_screen.dart';
import 'package:chismes/features/gossip/presentation/controllers/add_gossip_controller.dart';
import 'package:chismes/features/gossip/presentation/widgets/submit_button.dart';
import 'package:chismes/features/gossip/presentation/widgets/location_selector.dart';
import 'package:chismes/features/gossip/domain/entities/gossip.dart';
import 'package:chismes/features/location/domain/entities/country.dart';
import 'package:chismes/features/location/domain/entities/region.dart';
import 'package:chismes/features/location/domain/entities/city.dart';
import 'package:chismes/core/result/result.dart';
import 'package:chismes/core/error/failure.dart';
import 'package:chismes/core/error/error_codes.dart';

import '../controllers/add_gossip_controller_test.mocks.dart';

void main() {
  late MockGetCountries mockGetCountries;
  late MockGetRegionsByCountry mockGetRegionsByCountry;
  late MockGetCitiesByRegion mockGetCitiesByRegion;
  late MockCreateGossip mockCreateGossip;
  late MockLocationService mockLocationService;
  late AddGossipController controller;

  // Mock data
  final mockCountries = [
    const Country(id: '1', code: 'CO', name: 'Colombia'),
  ];

  final mockRegions = [
    const Region(id: 'ant', name: 'Antioquia', countryId: '1', type: 'department'),
  ];

  final mockCities = [
    const City(id: 'med', name: 'Medellín', regionId: 'ant'),
  ];

  final mockGossip = Gossip(
    id: 'test-123',
    countryId: '1',
    regionId: 'ant',
    cityId: 'med',
    subject: 'Test Subject',
    content: 'Test Content',
    audioUrl: null,
    imageUrl: null,
    publishedAs: PublishAs.anonymous,
    status: GossipStatus.published,
    moderationStatus: ModerationStatus.approved,
    reportedCount: 0,
    viewCount: 0,
    deletedAt: null,
    deletedBy: null,
    visibility: GossipVisibility.public,
    createdAt: DateTime.now(),
    createdBy: 'user-123',
    modifiedAt: null,
    modifiedBy: null,
  );

  setUpAll(() {
    // Provide dummy values for mockito
    provideDummy<Result<Failure, List<Country>>>(Result.success(const []));
    provideDummy<Result<Failure, List<Region>>>(Result.success(const []));
    provideDummy<Result<Failure, List<City>>>(Result.success(const []));
    provideDummy<Result<Failure, Gossip>>(
      Result.success(
        Gossip(
          id: 'dummy',
          countryId: '1',
          regionId: '1',
          cityId: '1',
          subject: 'Dummy',
          content: 'Dummy',
          audioUrl: null,
          imageUrl: null,
          publishedAs: PublishAs.anonymous,
          status: GossipStatus.published,
          moderationStatus: ModerationStatus.approved,
          reportedCount: 0,
          viewCount: 0,
          deletedAt: null,
          deletedBy: null,
          visibility: GossipVisibility.public,
          createdAt: DateTime.now(),
          createdBy: 'dummy',
          modifiedAt: null,
          modifiedBy: null,
        ),
      ),
    );
  });

  setUp(() {
    mockGetCountries = MockGetCountries();
    mockGetRegionsByCountry = MockGetRegionsByCountry();
    mockGetCitiesByRegion = MockGetCitiesByRegion();
    mockCreateGossip = MockCreateGossip();
    mockLocationService = MockLocationService();

    // Stubs por defecto
    when(mockGetCountries.call())
        .thenAnswer((_) async => Result.success(mockCountries));
    when(mockGetRegionsByCountry.call(any))
        .thenAnswer((_) async => Result.success(mockRegions));
    when(mockGetCitiesByRegion.call(any))
        .thenAnswer((_) async => Result.success(mockCities));
    when(mockLocationService.getDefaultLocation())
        .thenAnswer((_) async => null);
    when(mockLocationService.getCurrentPosition())
        .thenAnswer((_) async => null);
    when(mockLocationService.getCityFromCoordinates(any, any))
        .thenAnswer((_) async => null);

    controller = AddGossipController(
      getCountries: mockGetCountries,
      getRegionsByCountry: mockGetRegionsByCountry,
      getCitiesByRegion: mockGetCitiesByRegion,
      createGossip: mockCreateGossip,
      locationService: mockLocationService,
      autoInitialize: false,
    );
  });

  tearDown(() {
    controller.dispose();
  });

  Widget createTestableWidget({
    required AddGossipController controller,
  }) {
    return MaterialApp(
      home: AddGossipScreen(
        controller: controller,
      ),
    );
  }

  group('AddGossipScreen - Widget Tests Críticos', () {
    // TODO: Actualizar estos tests - el screen ahora usa CompactLocationSelector
    // en lugar de LocationSelector, y la estructura cambió significativamente.
    // Estos tests necesitan reescritura completa para reflejar la implementación actual.
  }, skip: 'Tests desactualizados - requieren reescritura para CompactLocationSelector');

  group('AddGossipScreen - Widget Tests Críticos [DESHABILITADO]', () {
    testWidgets('TEST 1: debe renderizar formulario completo', (tester) async {
      // Arrange & Act
      await tester.pumpWidget(createTestableWidget(controller: controller));
      await tester.pumpAndSettle();

      // Assert - Verificar que todos los elementos críticos están presentes
      expect(find.text('Nuevo Chisme 📝'), findsOneWidget);
      expect(find.byType(LocationSelector), findsOneWidget);
      expect(find.byType(TextField), findsNWidgets(2)); // subject y content
      expect(find.byType(SubmitButton), findsOneWidget);
    });

    testWidgets('TEST 2: debe validar campos vacíos antes de submit', (tester) async {
      // Arrange
      await tester.pumpWidget(createTestableWidget(controller: controller));
      await tester.pumpAndSettle();

      // Act - Scroll hasta el botón y hacer tap
      await tester.dragUntilVisible(
        find.byType(SubmitButton),
        find.byType(SingleChildScrollView),
        const Offset(0, -50),
      );
      await tester.tap(find.byType(SubmitButton));
      await tester.pumpAndSettle();

      // Assert - No debe llamar a createGossip porque validación falla
      verifyNever(mockCreateGossip.call(input: any, imageFile: any));
    });

    testWidgets('TEST 3: debe mostrar loading durante submit', (tester) async {
      // Arrange
      when(mockCreateGossip.call(input: any, imageFile: any)).thenAnswer((_) async {
        await Future.delayed(const Duration(milliseconds: 100));
        return Result.success(mockGossip);
      });

      await tester.pumpWidget(createTestableWidget(controller: controller));
      await tester.pumpAndSettle();

      // Llenar formulario
      final subjectField = find.byType(TextField).first;
      final contentField = find.byType(TextField).last;

      await tester.enterText(subjectField, 'Test Subject');
      await tester.enterText(contentField, 'Test Content');

      // Seleccionar ubicación
      await controller.selectCountry('1');
      await controller.selectRegion('ant');
      controller.selectCity('med');
      await tester.pumpAndSettle();

      // Act - Scroll y submit
      await tester.dragUntilVisible(
        find.byType(SubmitButton),
        find.byType(SingleChildScrollView),
        const Offset(0, -50),
      );
      await tester.tap(find.byType(SubmitButton));
      await tester.pump(); // Solo un pump para ver el loading

      // Assert - Debe estar en estado loading
      expect(controller.state.isSubmitting, isTrue);

      // Esperar a que termine
      await tester.pumpAndSettle();
    });

    testWidgets('TEST 4: debe mostrar error cuando falla submit', (tester) async {
      // Arrange
      final failure = const NetworkFailure(code: ErrorCode.networkError);
      when(mockCreateGossip.call(input: any, imageFile: any))
          .thenAnswer((_) async => Result.failure(failure));

      await tester.pumpWidget(createTestableWidget(controller: controller));
      await tester.pumpAndSettle();

      // Llenar formulario
      final subjectField = find.byType(TextField).first;
      final contentField = find.byType(TextField).last;

      await tester.enterText(subjectField, 'Test Subject');
      await tester.enterText(contentField, 'Test Content');

      // Seleccionar ubicación
      await controller.selectCountry('1');
      await controller.selectRegion('ant');
      controller.selectCity('med');
      await tester.pumpAndSettle();

      // Act - Scroll y submit que falla
      await tester.dragUntilVisible(
        find.byType(SubmitButton),
        find.byType(SingleChildScrollView),
        const Offset(0, -50),
      );
      await tester.tap(find.byType(SubmitButton));
      await tester.pumpAndSettle();

      // Assert - Debe mostrar mensaje de error
      expect(find.byIcon(Icons.error_outline), findsOneWidget);
      expect(controller.state.failure, equals(failure));
    });

    testWidgets('TEST 5: debe cargar regiones y ciudades al seleccionar ubicación', (tester) async {
      // Arrange
      await tester.pumpWidget(createTestableWidget(controller: controller));
      await tester.pumpAndSettle();

      // Act - Seleccionar país
      await controller.selectCountry('1');
      await tester.pumpAndSettle();

      // Assert - Debe haber cargado regiones
      expect(controller.state.regions, equals(mockRegions));
      verify(mockGetRegionsByCountry.call('1')).called(1);

      // Act - Seleccionar región
      await controller.selectRegion('ant');
      await tester.pumpAndSettle();

      // Assert - Debe haber cargado ciudades
      expect(controller.state.cities, equals(mockCities));
      verify(mockGetCitiesByRegion.call('ant')).called(1);
    });

    testWidgets('TEST 6: debe prevenir doble submit', (tester) async {
      // Arrange
      when(mockCreateGossip.call(input: any, imageFile: any)).thenAnswer((_) async {
        await Future.delayed(const Duration(milliseconds: 200));
        return Result.success(mockGossip);
      });

      await tester.pumpWidget(createTestableWidget(controller: controller));
      await tester.pumpAndSettle();

      // Llenar formulario
      final subjectField = find.byType(TextField).first;
      final contentField = find.byType(TextField).last;

      await tester.enterText(subjectField, 'Test Subject');
      await tester.enterText(contentField, 'Test Content');

      await controller.selectCountry('1');
      await controller.selectRegion('ant');
      controller.selectCity('med');
      await tester.pumpAndSettle();

      // Act - Scroll y submit dos veces
      await tester.dragUntilVisible(
        find.byType(SubmitButton),
        find.byType(SingleChildScrollView),
        const Offset(0, -50),
      );
      await tester.tap(find.byType(SubmitButton));
      await tester.pump();

      // Durante el submit, isSubmitting debe ser true
      expect(controller.state.isSubmitting, isTrue);

      // Intentar segundo submit (debe ser ignorado)
      await tester.tap(find.byType(SubmitButton));
      await tester.pump();

      // Esperar a que termine
      await tester.pumpAndSettle();

      // Assert - Solo debe haber llamado una vez
      verify(mockCreateGossip.call(input: any, imageFile: any)).called(1);
    });

    testWidgets('TEST 7: debe mostrar diálogo de éxito después de submit exitoso', (tester) async {
      // Arrange
      when(mockCreateGossip.call(input: any, imageFile: any))
          .thenAnswer((_) async => Result.success(mockGossip));

      await tester.pumpWidget(createTestableWidget(
        controller: controller,
      ));
      await tester.pumpAndSettle();

      // Llenar formulario
      final subjectField = find.byType(TextField).first;
      final contentField = find.byType(TextField).last;

      await tester.enterText(subjectField, 'Test Subject');
      await tester.enterText(contentField, 'Test Content');

      await controller.selectCountry('1');
      await controller.selectRegion('ant');
      controller.selectCity('med');
      await tester.pumpAndSettle();

      // Act - Scroll y submit exitoso
      await tester.dragUntilVisible(
        find.byType(SubmitButton),
        find.byType(SingleChildScrollView),
        const Offset(0, -50),
      );
      await tester.tap(find.byType(SubmitButton));
      await tester.pumpAndSettle();

      // Assert - Debe mostrar diálogo de éxito
      expect(find.text('¡Chisme publicado!'), findsOneWidget);
      expect(find.byIcon(Icons.check_circle), findsOneWidget);

      // Act - Cerrar diálogo
      await tester.tap(find.text('Aceptar'));
      await tester.pumpAndSettle();

      // Assert - El diálogo debe cerrarse
      expect(find.text('¡Chisme publicado!'), findsNothing);
    });

    testWidgets('TEST 8: debe limpiar formulario después de submit exitoso', (tester) async {
      // Arrange
      when(mockCreateGossip.call(input: any, imageFile: any))
          .thenAnswer((_) async => Result.success(mockGossip));

      await tester.pumpWidget(createTestableWidget(controller: controller));
      await tester.pumpAndSettle();

      // Llenar formulario
      final subjectField = find.byType(TextField).first;
      final contentField = find.byType(TextField).last;

      await tester.enterText(subjectField, 'Test Subject');
      await tester.enterText(contentField, 'Test Content');

      await controller.selectCountry('1');
      await controller.selectRegion('ant');
      controller.selectCity('med');
      await tester.pumpAndSettle();

      // Verificar que los campos tienen texto
      expect(find.text('Test Subject'), findsOneWidget);
      expect(find.text('Test Content'), findsOneWidget);

      // Act - Scroll y submit
      await tester.dragUntilVisible(
        find.byType(SubmitButton),
        find.byType(SingleChildScrollView),
        const Offset(0, -50),
      );
      await tester.tap(find.byType(SubmitButton));
      await tester.pumpAndSettle();

      // Cerrar diálogo
      await tester.tap(find.text('Aceptar'));
      await tester.pumpAndSettle();

      // Assert - Formulario debe estar limpio
      expect(controller.state.subject, isEmpty);
      expect(controller.state.content, isEmpty);
      expect(controller.state.selectedCountryId, isNull);
      expect(controller.state.selectedRegionId, isNull);
      expect(controller.state.selectedCityId, isNull);
    });
  });
}
