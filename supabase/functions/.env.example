# Configuración de Edge Functions
# Copia este archivo a .env y reemplaza con tus claves reales

# OpenAI API Key (OPCIONAL - si no está, solo usa reglas locales)
# Obtén tu clave en: https://platform.openai.com/api-keys
# Costo: GRATIS (Moderation API sin límite)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (estas se configuran automáticamente)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
